# Required Amazon credentials
AMAZON_EMAIL=your-amazon-account@example.com
AMAZON_PASSWORD=change-me
LOG_LEVEL=INFO

# Run daily. Leave empty for one run followed by container exit.
SCHEDULE=24h
# Only inspect orders from this many recent calendar days.
LOOKBACK_DAYS=56

# Linux/NAS user that owns ./invoices and ./data. `id -u` and `id -g` show
# suitable values. Docker Desktop users can normally keep these defaults.
PUID=1000
PGID=1000

# Dedicated mailbox used for Amazon OTP codes and failure notifications.
# MAIL_USERNAME and MAIL_PASSWORD are shared by IMAP and SMTP.
MAIL_USERNAME=your-address@example.com
MAIL_PASSWORD=change-me
MAIL_IMAP_HOST=imap.strato.de
MAIL_IMAP_PORT=993
MAIL_IMAP_FOLDER=INBOX
MAIL_SMTP_HOST=smtp.strato.de
MAIL_SMTP_PORT=465
MAIL_NOTIFICATION_TO=your-alert-address@example.com

# Permanently empty the dedicated OTP inbox before every login.
CLEAR_OTP_INBOX=false
AMAZON_OTP_TIMEOUT=120
AMAZON_OTP_POLL_INTERVAL=5

# Set false only when you want to inspect a visible local browser.
CHROME_HEADLESS=true

# Optional Paperless-ngx upload. Leave blank to only save invoices locally.
PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_CORRESPONDENT=
PAPERLESS_DOCUMENT_TYPE=
PAPERLESS_TAGS=
PAPERLESS_STORAGE_PATH=
